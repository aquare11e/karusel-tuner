# Linux host use (Plex on this SAME host with network_mode: host):
RELAY_PORT=18080
PUBLIC_BASE_URL=http://127.0.0.1:18080
# Tuners announced to Plex: recording + live viewing at the same time.
MAX_VIEWERS=2
STARTUP_TIMEOUT=45s
# How long to keep restarting Streamlink after the stream drops mid-response:
# RECONNECT_WINDOW=5m

# Programme guide (XMLTV at /epg.xml). Change the time zone in the path only
# if the web stream follows a different regional feed than Moscow.
# EPG_SOURCE_URL=https://www.karusel-tv.ru/schedule/Europe/Moscow
# EPG_REFRESH=6h
# EPG_DAYS=12

# OpenVPN profile: the whole .ovpn file in base64 on one line
#   macOS: base64 -i client.ovpn     Linux: base64 -w0 client.ovpn
# Leave empty to use vpn/client.ovpn instead. Host names in `remote` are
# resolved to IPv4 on every deploy. Inline <ca>/<cert>/<key> only: separate
# certificate files are not supported.
OPENVPN_CONFIG_BASE64=
# VPN login, if the profile uses auth-user-pass (empty for certificate-only).
# Store real credentials only in .env, then chmod 600 .env
OPENVPN_USER=
OPENVPN_PASSWORD=

# If the MediaVitrina player URL changes, override SOURCE_URL:
# SOURCE_URL=https://player.mediavitrina.ru/.../player.html

# Local test bench only (compose.local-plex.yaml). Never commit a real token.
PLEX_CLAIM=
